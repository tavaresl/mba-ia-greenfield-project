# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM='"StreamTube" <noreply@streamtube.com>'

# Object storage (MinIO via pgsty/silo, S3 API)
# Services reach MinIO through the Compose service name; S3_PUBLIC_ENDPOINT is
# the only host-facing value (presigned URLs are consumed outside the network).
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=streamtube
S3_SECRET_KEY=streamtube-secret
S3_BUCKET=streamtube
S3_UPLOAD_URL_TTL_SECONDS=3600
S3_DOWNLOAD_URL_TTL_SECONDS=14400

# Queue (BullMQ on Redis)
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_PREFIX=bull

# Videos
VIDEO_MAX_UPLOAD_BYTES=10737418240
VIDEO_UPLOAD_PART_SIZE_BYTES=104857600
VIDEO_MEDIA_TIMEOUT_SECONDS=300
