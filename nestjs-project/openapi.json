  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "CreateVideoDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "My first video",
            "maxLength": 100,
            "description": "Trimmed; editable later"
          },
          "file_name": {
            "type": "string",
            "example": "clip.mp4",
            "maxLength": 255,
            "description": "Original file name; used as the download name"
          },
          "file_size": {
            "type": "number",
            "example": 11534336,
            "minimum": 1,
            "maximum": 10737418240,
            "description": "File size in bytes (at most 10 GiB)"
          },
          "mime_type": {
            "type": "string",
            "enum": [
              "video/mp4",
              "video/webm"
            ],
            "example": "video/mp4"
          }
        },
        "required": [
          "title",
          "file_name",
          "file_size",
          "mime_type"
        ]
      },
      "CreateVideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "dBjftJeZ4CV",
            "description": "Public video id"
          },
          "title": {
            "type": "string",
            "example": "My first video"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ],
            "example": "draft"
          },
          "part_size": {
            "type": "number",
            "example": 104857600,
            "description": "Bytes per part; every part except the last has this size"
          },
          "part_count": {
            "type": "number",
            "example": 3
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "part_size",
          "part_count"
        ]
      },
      "SignUploadPartsDto": {
        "type": "object",
        "properties": {
          "part_numbers": {
            "example": [
              1,
              2
            ],
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "description": "Part numbers (1-based) to sign; at most the video part_count",
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "part_numbers"
        ]
      },
      "SignedPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "description": "Presigned URL; PUT the raw part bytes to it",
            "example": "http://localhost:9000/streamtube/videos/…?X-Amz-Signature=…"
          }
        },
        "required": [
          "part_number",
          "url"
        ]
      },
      "SignedPartsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SignedPartDto"
            }
          },
          "expires_in": {
            "type": "number",
            "example": 3600,
            "description": "URL lifetime in seconds"
          }
        },
        "required": [
          "parts",
          "expires_in"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "etag": {
            "type": "string",
            "example": "\"9b2cf535f27731c974343645a3985328\""
          },
          "size": {
            "type": "number",
            "example": 104857600,
            "description": "Part size in bytes"
          }
        },
        "required": [
          "part_number",
          "etag",
          "size"
        ]
      },
      "UploadedPartsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "CompletedPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1,
            "minimum": 1,
            "maximum": 10000
          },
          "etag": {
            "type": "string",
            "example": "\"9b2cf535f27731c974343645a3985328\"",
            "description": "ETag returned by storage for the uploaded part"
          }
        },
        "required": [
          "part_number",
          "etag"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {
          "parts": {
            "minItems": 1,
            "maxItems": 10000,
            "description": "Every uploaded part with its ETag, in any order",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompletedPartDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "CompleteUploadResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "dBjftJeZ4CV",
            "description": "Public video id"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ],
            "example": "processing"
          }
        },
        "required": [
          "id",
          "status"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "dBjftJeZ4CV",
            "description": "Public video id"
          },
          "title": {
            "type": "string",
            "example": "My first video"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ],
            "example": "ready"
          },
          "failure_reason": {
            "type": "string",
            "nullable": true,
            "example": null,
            "description": "Set only when status is failed"
          },
          "original_file_name": {
            "type": "string",
            "example": "clip.mp4"
          },
          "mime_type": {
            "type": "string",
            "example": "video/mp4"
          },
          "file_size": {
            "type": "number",
            "nullable": true,
            "example": 51293
          },
          "duration_seconds": {
            "type": "number",
            "nullable": true,
            "example": 3.04
          },
          "width": {
            "type": "number",
            "nullable": true,
            "example": 640
          },
          "height": {
            "type": "number",
            "nullable": true,
            "example": 360
          },
          "video_codec": {
            "type": "string",
            "nullable": true,
            "example": "h264"
          },
          "audio_codec": {
            "type": "string",
            "nullable": true,
            "example": "aac"
          },
          "container_format": {
            "type": "string",
            "nullable": true,
            "example": "mov,mp4,m4a,3gp,3g2,mj2"
          },
          "bitrate": {
            "type": "number",
            "nullable": true,
            "example": 136781
          },
          "thumbnail_url": {
            "type": "string",
            "nullable": true,
            "description": "Presigned URL of the thumbnail; null until the video is ready"
          },
          "created_at": {
            "type": "string",
            "example": "2026-10-27T11:20:29.000Z"
          },
          "updated_at": {
            "type": "string",
            "example": "2026-10-27T11:20:31.000Z"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "failure_reason",
          "original_file_name",
          "mime_type",
          "file_size",
          "duration_seconds",
          "width",
          "height",
          "video_codec",
          "audio_codec",
          "container_format",
          "bitrate",
          "thumbnail_url",
          "created_at",
          "updated_at"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}